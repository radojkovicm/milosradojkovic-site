<!-- BLOG PREVIEW -->
{{#get "posts" limit="3"}}
{{#if posts}}
<section class="blog-preview">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">$ ls ~/blog/recent</span>
            <h2 class="section-title">Latest Posts</h2>
        </div>

        <div class="posts-grid">
            {{#foreach posts}}
            <article class="post-card">
                <div class="post-meta">
                    <span class="post-date">{{date published_at format="DD MMM YYYY"}}</span>
                </div>
                <h3 class="post-title"><a href="{{url}}">{{title}}</a></h3>
                <p class="post-excerpt">{{excerpt words="20"}}</p>
                <a href="{{url}}" class="post-link">read_more() →</a>
            </article>
            {{/foreach}}
        </div>

        <div class="blog-cta">
            <a href="/blog" class="btn-secondary">View All Posts →</a>
        </div>
    </div>
</section>
{{/if}}
{{/get}}
