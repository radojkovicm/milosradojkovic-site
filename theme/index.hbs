{{!< default}}

<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-tag">
                <span class="tag-dot"></span>
                <span>Open to opportunities</span>
            </div>

            <h1 class="hero-title">
                Hey, I'm <span class="highlight">Miloš</span><br>
                <span class="hero-role" id="typingRole"></span>
            </h1>

            <p class="hero-desc">
                Business Central Developer & Systems Administrator based in Kočevje, Slovenia.
                Building ERP solutions, automating workflows, and managing cloud infrastructure.
            </p>

            <div class="hero-cta">
                <a href="/experience" class="btn-primary">View Experience</a>
                <a href="/contact" class="btn-secondary">Get in Touch</a>
            </div>

            <div class="hero-tech">
                <span class="tech-tag">AL / BC</span>
                <span class="tech-tag">Python</span>
                <span class="tech-tag">Azure</span>
                <span class="tech-tag">SQL</span>
                <span class="tech-tag">Docker</span>
                <span class="tech-tag">Linux</span>
                <span class="tech-tag">PowerShell</span>
                <span class="tech-tag">REST API</span>
            </div>
        </div>

        <div class="hero-image">
            <div class="image-frame">
                <div class="image-placeholder">
                    <img src="https://milosradojkovic.dev/content/images/2026/03/received_1341668436525365--1--2.jpeg" alt="Miloš Radojković">
                </div>
                <div class="image-decoration"></div>
            </div>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="stats">
