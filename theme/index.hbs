{{!< default}}

<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-tag">
                <span class="tag-dot"></span>
                <span>Open to opportunities</span>
            </div>

            <h1 class="hero-title">
                Hey, I'm <span class="highlight">Miloš</span><br>
                <span class="hero-role" id="typingRole"></span>
            </h1>

            <p class="hero-desc">
                Business Central Developer & Systems Administrator based in Kočevje, Slovenia.
                Building ERP solutions, automating workflows, and managing cloud infrastructure.
            </p>

            <div class="hero-cta">
                <a href="/experience" class="btn-primary">View Experience</a>
                <a href="/contact" class="btn-secondary">Get in Touch</a>
            </div>

            <div class="hero-tech">
                <span class="tech-tag">AL / BC</span>
                <span class="tech-tag">SQL</span>
                <span class="tech-tag">Python</span>
                <span class="tech-tag">PowerShell</span>
                <span class="tech-tag">M365 / Entra ID</span>
                <span class="tech-tag">Azure</span>
                <span class="tech-tag">Docker</span>
                <span class="tech-tag">REST API</span>
            </div>
        </div>

        <div class="hero-image">
            <div class="image-frame">
                <div class="image-placeholder">
                    <img src="https://milosradojkovic.dev/content/images/2026/03/received_1341668436525365--1--2.jpeg" alt="Miloš Radojković">
                </div>
                <div class="image-decoration"></div>
            </div>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="stats">
    <div class="stats-container">
        <div class="stat-item">
            <span class="stat-number">2019</span>
            <span class="stat-label">In ERP since</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-number">Dev</span>
            <span class="stat-label">&amp; Ops</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-number">AL</span>
            <span class="stat-label">Primary Language</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-number">D365</span>
            <span class="stat-label">BC Specialist</span>
        </div>
    </div>
</section>

<!-- TIMELINE SECTION -->
<section class="timeline-section">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">$ git log --career</span>
            <h2 class="section-title">My Timeline</h2>
        </div>

        <div class="timeline">
            <div class="timeline-line"></div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Jun 2019</div>
                <div class="timeline-card">
                    <span class="timeline-company">Teknoxgroup</span>
                    <span class="timeline-role">Business Analyst</span>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Oct 2020</div>
                <div class="timeline-card">
                    <span class="timeline-company">Novartis</span>
                    <span class="timeline-role">IT Associate</span>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Mar 2022</div>
                <div class="timeline-card">
                    <span class="timeline-company">BE-terna</span>
                    <span class="timeline-role">Application Engineer</span>
                </div>
            </div>

            <div class="timeline-item active">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Jun 2023 → Present</div>
                <div class="timeline-card">
                    <span class="timeline-company">Intersocks Group</span>
                    <span class="timeline-role">Informatics — BC Dev & Sys Admin</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SKILLS SECTION -->
<section class="skills-section">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">$ cat skills.json</span>
            <h2 class="section-title">Tech Stack</h2>
        </div>

        <div class="skills-grid">
            <div class="skill-category">
                <h3 class="skill-cat-title">ERP / Business Central</h3>
                <div class="skill-list">
                    <span class="tech-tag">AL</span>
                    <span class="tech-tag">Dynamics 365 Business Central</span>
                    <span class="tech-tag">C/AL / Dynamics NAV</span>
                    <span class="tech-tag">Pantheon ERP</span>
                    <span class="tech-tag">REST / OData / SOAP APIs</span>
                    <span class="tech-tag">ERP data migration</span>
                </div>
            </div>

            <div class="skill-category">
                <h3 class="skill-cat-title">Development &amp; Automation</h3>
                <div class="skill-list">
                    <span class="tech-tag">Python</span>
                    <span class="tech-tag">FastAPI</span>
                    <span class="tech-tag">SQL Server / T-SQL</span>
                    <span class="tech-tag">PostgreSQL</span>
                    <span class="tech-tag">PowerShell</span>
                    <span class="tech-tag">Power BI</span>
                    <span class="tech-tag">n8n</span>
                    <span class="tech-tag">Git</span>
                </div>
            </div>

            <div class="skill-category">
                <h3 class="skill-cat-title">Infrastructure &amp; Cloud</h3>
                <div class="skill-list">
                    <span class="tech-tag">Microsoft 365</span>
                    <span class="tech-tag">Entra ID</span>
                    <span class="tech-tag">Microsoft Intune</span>
                    <span class="tech-tag">Active Directory / GPO</span>
                    <span class="tech-tag">Azure</span>
                    <span class="tech-tag">Google Workspace</span>
                    <span class="tech-tag">Jira / Confluence admin</span>
                    <span class="tech-tag">Docker</span>
                    <span class="tech-tag">Linux</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- BLOG PREVIEW -->
{{#get "posts" limit="3"}}
{{#if posts}}
<section class="blog-preview">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">$ ls ~/blog/recent</span>
            <h2 class="section-title">Latest Posts</h2>
        </div>

        <div class="posts-grid">
            {{#foreach posts}}
            <article class="post-card">
                <div class="post-meta">
                    <span class="post-date">{{date published_at format="DD MMM YYYY"}}</span>
                </div>
                <h3 class="post-title"><a href="{{url}}">{{title}}</a></h3>
                <p class="post-excerpt">{{excerpt words="20"}}</p>
                <a href="{{url}}" class="post-link">read_more() →</a>
            </article>
            {{/foreach}}
        </div>

        <div class="blog-cta">
            <a href="/blog" class="btn-secondary">View All Posts →</a>
        </div>
    </div>
</section>
{{/if}}
{{/get}}
