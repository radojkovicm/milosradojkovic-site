                <div class="timeline-card">
                    <span class="timeline-company">Teknoxgroup</span>
                    <span class="timeline-role">Business Analyst</span>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Oct 2020</div>
                <div class="timeline-card">
                    <span class="timeline-company">Novartis</span>
                    <span class="timeline-role">IT Associate</span>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Mar 2022</div>
                <div class="timeline-card">
                    <span class="timeline-company">BE-terna</span>
                    <span class="timeline-role">Application Engineer</span>
                </div>
            </div>

            <div class="timeline-item active">
                <div class="timeline-dot"></div>
                <div class="timeline-date">Jun 2023 → Present</div>
                <div class="timeline-card">
                    <span class="timeline-company">Intersocks Group</span>
