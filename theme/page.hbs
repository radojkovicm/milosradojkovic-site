{{!< default}}

{{!-- Generic page template. Experience, Contact and Blog use page-{slug}.hbs instead. --}}
{{#post}}
<section class="page-hero">
    <div class="section-container">
        <h1 class="page-title">{{title}}</h1>
        {{#if custom_excerpt}}
        <p class="page-subtitle">{{custom_excerpt}}</p>
        {{/if}}
    </div>
</section>

<section class="generic-page">
    <div class="section-container">
        <div class="post-content gh-content">
            {{content}}
        </div>
    </div>
</section>
{{/post}}
